# Cole a URI do Atlas (Connect > Drivers). Sem aspas é o mais seguro.
# Se a senha tiver símbolos (@ # / : ?), codifique (ex.: @ vira %40).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/triptogether
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-um-segredo-aleatorio-forte
# Opcional: só se der erro "querySrv ECONNREFUSED" (DNS da rede bloqueando o Atlas)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
